{
  "id": "opg.lpa-activation.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "death-details-confirmed"
    },
    {
      "id": "return-preferences-set",
      "receipt": true
    },
    {
      "id": "documents-submitted",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible-or-not-attorney"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case-requires-manual-intervention"
    },
    {
      "from": "consent-given",
      "to": "death-details-confirmed",
      "trigger": "confirm-death-details"
    },
    {
      "from": "death-details-confirmed",
      "to": "return-preferences-set",
      "trigger": "set-return-preferences"
    },
    {
      "from": "return-preferences-set",
      "to": "documents-submitted",
      "trigger": "submit-documents"
    },
    {
      "from": "documents-submitted",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}