{
  "id": "hmrc-spl.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "partner-identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "employment-details-submitted"
    },
    {
      "id": "partner-employment-verified"
    },
    {
      "id": "leave-plan-submitted"
    },
    {
      "id": "curtailment-confirmed"
    },
    {
      "id": "employer-notice-given"
    },
    {
      "id": "assessment"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "partner-identity-verified",
      "trigger": "verify-partner-identity"
    },
    {
      "from": "partner-identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "employment-details-submitted",
      "trigger": "submit-employment-details"
    },
    {
      "from": "employment-details-submitted",
      "to": "partner-employment-verified",
      "trigger": "verify-partner-employment"
    },
    {
      "from": "partner-employment-verified",
      "to": "leave-plan-submitted",
      "trigger": "submit-leave-plan"
    },
    {
      "from": "leave-plan-submitted",
      "to": "curtailment-confirmed",
      "trigger": "confirm-curtailment"
    },
    {
      "from": "curtailment-confirmed",
      "to": "employer-notice-given",
      "trigger": "give-employer-notice"
    },
    {
      "from": "employer-notice-given",
      "to": "assessment",
      "trigger": "begin-assessment"
    },
    {
      "from": "assessment",
      "to": "decision",
      "trigger": "make-decision"
    },
    {
      "from": "decision",
      "to": "completed",
      "trigger": "approve"
    },
    {
      "from": "decision",
      "to": "rejected",
      "trigger": "reject-application"
    }
  ]
}