{
  "id": "hmcts-probate.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "will-status-determined"
    },
    {
      "id": "estate-valued"
    },
    {
      "id": "iht-reported"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "will-uploaded"
    },
    {
      "id": "executor-details-confirmed"
    },
    {
      "id": "estate-details-submitted"
    },
    {
      "id": "fee-calculated"
    },
    {
      "id": "fee-paid",
      "receipt": true
    },
    {
      "id": "documents-submitted"
    },
    {
      "id": "legal-declaration-signed"
    },
    {
      "id": "application-submitted",
      "receipt": true
    },
    {
      "id": "under-review"
    },
    {
      "id": "additional-information-requested"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "grant-issued",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "will-status-determined",
      "trigger": "determine-will-status"
    },
    {
      "from": "will-status-determined",
      "to": "estate-valued",
      "trigger": "value-estate"
    },
    {
      "from": "estate-valued",
      "to": "iht-reported",
      "trigger": "report-iht"
    },
    {
      "from": "iht-reported",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "will-uploaded",
      "trigger": "upload-will",
      "condition": "will-exists"
    },
    {
      "from": "consent-given",
      "to": "executor-details-confirmed",
      "trigger": "skip-will",
      "condition": "no-will"
    },
    {
      "from": "will-uploaded",
      "to": "executor-details-confirmed",
      "trigger": "confirm-executors"
    },
    {
      "from": "executor-details-confirmed",
      "to": "estate-details-submitted",
      "trigger": "submit-estate-details"
    },
    {
      "from": "estate-details-submitted",
      "to": "fee-calculated",
      "trigger": "calculate-fee"
    },
    {
      "from": "fee-calculated",
      "to": "fee-paid",
      "trigger": "pay-fee",
      "condition": "fee-required"
    },
    {
      "from": "fee-calculated",
      "to": "documents-submitted",
      "trigger": "skip-payment",
      "condition": "no-fee"
    },
    {
      "from": "fee-paid",
      "to": "documents-submitted",
      "trigger": "submit-documents"
    },
    {
      "from": "documents-submitted",
      "to": "legal-declaration-signed",
      "trigger": "sign-declaration"
    },
    {
      "from": "legal-declaration-signed",
      "to": "application-submitted",
      "trigger": "submit-application"
    },
    {
      "from": "application-submitted",
      "to": "under-review",
      "trigger": "begin-review"
    },
    {
      "from": "under-review",
      "to": "additional-information-requested",
      "trigger": "request-information",
      "condition": "information-needed"
    },
    {
      "from": "additional-information-requested",
      "to": "under-review",
      "trigger": "provide-information"
    },
    {
      "from": "under-review",
      "to": "decision",
      "trigger": "make-decision"
    },
    {
      "from": "decision",
      "to": "grant-issued",
      "trigger": "issue-grant"
    },
    {
      "from": "decision",
      "to": "rejected",
      "trigger": "reject-application"
    }
  ]
}