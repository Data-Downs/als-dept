{
  "id": "la.food-hygiene.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "business-details-provided"
    },
    {
      "id": "fee-confirmed",
      "receipt": true
    },
    {
      "id": "registration-submitted",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "not-eligible-or-edge-case"
    },
    {
      "from": "consent-given",
      "to": "business-details-provided",
      "trigger": "provide-business-details"
    },
    {
      "from": "business-details-provided",
      "to": "fee-confirmed",
      "trigger": "confirm-fee"
    },
    {
      "from": "fee-confirmed",
      "to": "registration-submitted",
      "trigger": "submit-registration"
    },
    {
      "from": "registration-submitted",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}