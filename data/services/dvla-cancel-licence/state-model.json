{
  "id": "dvla-cancel-licence.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "reason-confirmed"
    },
    {
      "id": "details-confirmed",
      "receipt": true
    },
    {
      "id": "notification-submitted",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "already-cancelled",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "already-cancelled",
      "trigger": "already-processed",
      "condition": "tell-us-once-duplicate"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "not-eligible-or-complex"
    },
    {
      "from": "consent-given",
      "to": "reason-confirmed",
      "trigger": "confirm-reason"
    },
    {
      "from": "reason-confirmed",
      "to": "details-confirmed",
      "trigger": "confirm-details"
    },
    {
      "from": "details-confirmed",
      "to": "notification-submitted",
      "trigger": "submit-notification"
    },
    {
      "from": "notification-submitted",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}