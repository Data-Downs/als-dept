{
  "id": "dwp-ni-number.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "documents-uploaded"
    },
    {
      "id": "details-submitted",
      "receipt": true
    },
    {
      "id": "pending-verification"
    },
    {
      "id": "awaiting-appointment"
    },
    {
      "id": "registered",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "documents-uploaded",
      "trigger": "upload-documents",
      "condition": "can-upload-documents"
    },
    {
      "from": "consent-given",
      "to": "awaiting-appointment",
      "trigger": "request-appointment",
      "condition": "cannot-upload-documents"
    },
    {
      "from": "documents-uploaded",
      "to": "details-submitted",
      "trigger": "submit-details"
    },
    {
      "from": "details-submitted",
      "to": "pending-verification",
      "trigger": "await-verification",
      "condition": "requires-manual-verification"
    },
    {
      "from": "details-submitted",
      "to": "registered",
      "trigger": "confirm-registration",
      "condition": "documents-verified"
    },
    {
      "from": "pending-verification",
      "to": "registered",
      "trigger": "verify-complete"
    },
    {
      "from": "awaiting-appointment",
      "to": "registered",
      "trigger": "appointment-complete"
    }
  ]
}