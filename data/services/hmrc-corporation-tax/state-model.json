{
  "id": "hmrc.corporation-tax.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "company-details-confirmed"
    },
    {
      "id": "accounting-period-set",
      "receipt": true
    },
    {
      "id": "registration-submitted",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "not-eligible-or-edge-case"
    },
    {
      "from": "consent-given",
      "to": "company-details-confirmed",
      "trigger": "confirm-company-details"
    },
    {
      "from": "company-details-confirmed",
      "to": "accounting-period-set",
      "trigger": "set-accounting-period"
    },
    {
      "from": "accounting-period-set",
      "to": "registration-submitted",
      "trigger": "submit-registration"
    },
    {
      "from": "registration-submitted",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}