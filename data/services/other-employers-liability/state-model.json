{
  "id": "other.employers-liability.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "business-details-provided"
    },
    {
      "id": "premium-estimated",
      "receipt": true
    },
    {
      "id": "insurer-selected"
    },
    {
      "id": "policy-purchased",
      "receipt": true
    },
    {
      "id": "certificate-obtained",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "exempt",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "exempt",
      "trigger": "mark-exempt",
      "condition": "not-required"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "complex-case"
    },
    {
      "from": "consent-given",
      "to": "business-details-provided",
      "trigger": "provide-business-details"
    },
    {
      "from": "business-details-provided",
      "to": "premium-estimated",
      "trigger": "calculate-premium"
    },
    {
      "from": "premium-estimated",
      "to": "insurer-selected",
      "trigger": "select-insurer"
    },
    {
      "from": "insurer-selected",
      "to": "policy-purchased",
      "trigger": "purchase-policy"
    },
    {
      "from": "policy-purchased",
      "to": "certificate-obtained",
      "trigger": "obtain-certificate"
    },
    {
      "from": "certificate-obtained",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}