      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "tribunal-referral",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "insolvency-referral",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
