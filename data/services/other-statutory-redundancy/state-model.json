    },
    {
      "from": "route-determined",
      "to": "tribunal-referral",
      "trigger": "refer-to-tribunal",
      "condition": "employer-refuses"
    },
    {
      "from": "route-determined",
      "to": "insolvency-referral",
      "trigger": "refer-to-insolvency",
      "condition": "employer-insolvent"
    },
    {
