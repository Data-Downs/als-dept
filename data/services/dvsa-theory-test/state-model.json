{
  "id": "dvsa.theory-test.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "slot-selected"
    },
    {
      "id": "payment-made",
      "receipt": true
    },
    {
      "id": "booking-confirmed",
      "receipt": true
    },
    {
      "id": "passed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "failed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "cancelled",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rescheduled",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "not-eligible-or-edge-case"
    },
    {
      "from": "consent-given",
      "to": "slot-selected",
      "trigger": "select-slot"
    },
    {
      "from": "slot-selected",
      "to": "payment-made",
      "trigger": "make-payment"
    },
    {
      "from": "payment-made",
      "to": "booking-confirmed",
      "trigger": "confirm-booking"
    },
    {
      "from": "booking-confirmed",
      "to": "passed",
      "trigger": "complete-test",
      "condition": "test-passed"
    },
    {
      "from": "booking-confirmed",
      "to": "failed",
      "trigger": "complete-test",
      "condition": "test-failed"
    },
    {
      "from": "booking-confirmed",
      "to": "cancelled",
      "trigger": "cancel-booking"
    },
    {
      "from": "booking-confirmed",
      "to": "rescheduled",
      "trigger": "reschedule-booking"
    },
    {
      "from": "rescheduled",
      "to": "slot-selected",
      "trigger": "select-new-slot"
    }
  ]
}