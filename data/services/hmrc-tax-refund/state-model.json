{
  "id": "hmrc.tax-refund.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "employment-details-entered"
    },
    {
      "id": "p45-details-submitted"
    },
    {
      "id": "bank-details-provided"
    },
    {
      "id": "declaration-signed"
    },
    {
      "id": "details-submitted",
      "receipt": true
    },
    {
      "id": "assessment"
    },
    {
      "id": "refund-calculated"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "payment-processing"
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "employment-details-entered",
      "trigger": "enter-employment-details"
    },
    {
      "from": "employment-details-entered",
      "to": "p45-details-submitted",
      "trigger": "submit-p45-details"
    },
    {
      "from": "p45-details-submitted",
      "to": "bank-details-provided",
      "trigger": "provide-bank-details"
    },
    {
      "from": "bank-details-provided",
      "to": "declaration-signed",
      "trigger": "sign-declaration"
    },
    {
      "from": "declaration-signed",
      "to": "details-submitted",
      "trigger": "submit-application"
    },
    {
      "from": "details-submitted",
      "to": "assessment",
      "trigger": "begin-assessment"
    },
    {
      "from": "assessment",
      "to": "refund-calculated",
      "trigger": "calculate-refund"
    },
    {
      "from": "refund-calculated",
      "to": "decision",
      "trigger": "make-decision"
    },
    {
      "from": "decision",
      "to": "payment-processing",
      "trigger": "approve"
    },
    {
      "from": "decision",
      "to": "rejected",
      "trigger": "reject-application"
    },
    {
      "from": "payment-processing",
      "to": "completed",
      "trigger": "payment-sent"
    }
  ]
}