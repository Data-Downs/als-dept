{
  "id": "hmrc.self-assessment.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "existing-registration-checked"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "registration-details-provided"
    },
    {
      "id": "registration-submitted",
      "receipt": true
    },
    {
      "id": "utr-assigned",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "reactivation-required",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "existing-registration-checked",
      "trigger": "check-existing-registration"
    },
    {
      "from": "existing-registration-checked",
      "to": "eligibility-checked",
      "trigger": "check-eligibility",
      "condition": "no-active-registration"
    },
    {
      "from": "existing-registration-checked",
      "to": "reactivation-required",
      "trigger": "route-to-reactivation",
      "condition": "inactive-registration-found"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "not-eligible-or-edge-case"
    },
    {
      "from": "consent-given",
      "to": "registration-details-provided",
      "trigger": "provide-details"
    },
    {
      "from": "registration-details-provided",
      "to": "registration-submitted",
      "trigger": "submit-registration"
    },
    {
      "from": "registration-submitted",
      "to": "utr-assigned",
      "trigger": "assign-utr"
    },
    {
      "from": "utr-assigned",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}