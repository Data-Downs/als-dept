{
  "id": "dwp.mandatory-reconsideration.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "decision-details-provided"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "risk-acknowledged"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "grounds-explained"
    },
    {
      "id": "evidence-submitted"
    },
    {
      "id": "request-submitted",
      "receipt": true
    },
    {
      "id": "under-assessment"
    },
    {
      "id": "decision-made",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "decision-details-provided",
      "trigger": "provide-decision-details"
    },
    {
      "from": "decision-details-provided",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "risk-acknowledged",
      "trigger": "proceed",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case-requires-different-process"
    },
    {
      "from": "risk-acknowledged",
      "to": "consent-given",
      "trigger": "grant-consent"
    },
    {
      "from": "consent-given",
      "to": "grounds-explained",
      "trigger": "explain-grounds"
    },
    {
      "from": "grounds-explained",
      "to": "evidence-submitted",
      "trigger": "submit-evidence"
    },
    {
      "from": "grounds-explained",
      "to": "request-submitted",
      "trigger": "submit-without-evidence",
      "condition": "no-additional-evidence"
    },
    {
      "from": "evidence-submitted",
      "to": "request-submitted",
      "trigger": "submit-request"
    },
    {
      "from": "request-submitted",
      "to": "under-assessment",
      "trigger": "begin-assessment"
    },
    {
      "from": "under-assessment",
      "to": "decision-made",
      "trigger": "issue-notice"
    },
    {
      "from": "decision-made",
      "to": "completed",
      "trigger": "accept-outcome",
      "condition": "decision-in-favour"
    },
    {
      "from": "decision-made",
      "to": "rejected",
      "trigger": "accept-outcome",
      "condition": "decision-upheld-or-worsened"
    },
    {
      "from": "decision-made",
      "to": "handed-off",
      "trigger": "proceed-to-tribunal",
      "condition": "citizen-wishes-to-appeal"
    }
  ]
}