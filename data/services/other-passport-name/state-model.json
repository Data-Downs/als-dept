{
  "id": "hmpo.other-passport-name.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "photo-submitted"
    },
    {
      "id": "documents-uploaded"
    },
    {
      "id": "payment-made",
      "receipt": true
    },
    {
      "id": "details-submitted"
    },
    {
      "id": "assessment"
    },
    {
      "id": "interview-required"
    },
    {
      "id": "interview-completed"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "photo-submitted",
      "trigger": "submit-photo"
    },
    {
      "from": "photo-submitted",
      "to": "documents-uploaded",
      "trigger": "upload-documents"
    },
    {
      "from": "documents-uploaded",
      "to": "payment-made",
      "trigger": "make-payment"
    },
    {
      "from": "payment-made",
      "to": "details-submitted",
      "trigger": "submit-details"
    },
    {
      "from": "details-submitted",
      "to": "assessment",
      "trigger": "begin-assessment"
    },
    {
      "from": "assessment",
      "to": "interview-required",
      "trigger": "request-interview",
      "condition": "interview-needed"
    },
    {
      "from": "assessment",
      "to": "decision",
      "trigger": "make-decision",
      "condition": "no-interview-needed"
    },
    {
      "from": "interview-required",
      "to": "interview-completed",
      "trigger": "complete-interview"
    },
    {
      "from": "interview-completed",
      "to": "assessment",
      "trigger": "continue-assessment"
    },
    {
      "from": "decision",
      "to": "completed",
      "trigger": "approve"
    },
    {
      "from": "decision",
      "to": "rejected",
      "trigger": "reject-application"
    }
  ]
}