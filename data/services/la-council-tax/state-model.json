{
  "id": "la-council-tax.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "new-address-registered"
    },
    {
      "id": "old-address-closed"
    },
    {
      "id": "discount-assessed",
      "receipt": true
    },
    {
      "id": "amount-calculated",
      "receipt": true
    },
    {
      "id": "payment-setup",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case-requires-manual-assessment"
    },
    {
      "from": "consent-given",
      "to": "new-address-registered",
      "trigger": "register-new-address"
    },
    {
      "from": "new-address-registered",
      "to": "old-address-closed",
      "trigger": "close-old-address"
    },
    {
      "from": "old-address-closed",
      "to": "discount-assessed",
      "trigger": "assess-discounts"
    },
    {
      "from": "discount-assessed",
      "to": "amount-calculated",
      "trigger": "calculate-amount"
    },
    {
      "from": "amount-calculated",
      "to": "payment-setup",
      "trigger": "setup-payment"
    },
    {
      "from": "payment-setup",
      "to": "completed",
      "trigger": "complete"
    }
  ]
}