{
  "id": "ch-register-ltd.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "name-checked"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "company-details-entered"
    },
    {
      "id": "directors-added"
    },
    {
      "id": "shareholders-added"
    },
    {
      "id": "psc-confirmed"
    },
    {
      "id": "articles-submitted"
    },
    {
      "id": "details-confirmed"
    },
    {
      "id": "payment-made",
      "receipt": true
    },
    {
      "id": "application-submitted"
    },
    {
      "id": "registered",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "name-checked",
      "trigger": "check-name-availability"
    },
    {
      "from": "name-checked",
      "to": "eligibility-checked",
      "trigger": "check-eligibility",
      "condition": "name-available"
    },
    {
      "from": "name-checked",
      "to": "not-started",
      "trigger": "choose-different-name",
      "condition": "name-unavailable"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "company-details-entered",
      "trigger": "enter-company-details"
    },
    {
      "from": "company-details-entered",
      "to": "directors-added",
      "trigger": "add-directors"
    },
    {
      "from": "directors-added",
      "to": "shareholders-added",
      "trigger": "add-shareholders-or-guarantors"
    },
    {
      "from": "shareholders-added",
      "to": "psc-confirmed",
      "trigger": "confirm-psc"
    },
    {
      "from": "psc-confirmed",
      "to": "articles-submitted",
      "trigger": "submit-articles"
    },
    {
      "from": "articles-submitted",
      "to": "details-confirmed",
      "trigger": "confirm-all-details"
    },
    {
      "from": "details-confirmed",
      "to": "payment-made",
      "trigger": "make-payment"
    },
    {
      "from": "payment-made",
      "to": "application-submitted",
      "trigger": "submit-application"
    },
    {
      "from": "application-submitted",
      "to": "registered",
      "trigger": "issue-certificate"
    }
  ]
}