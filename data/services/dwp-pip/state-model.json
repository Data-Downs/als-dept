{
  "id": "dwp-pip.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "basic-form-submitted"
    },
    {
      "id": "detailed-form-submitted"
    },
    {
      "id": "assessment-scheduled"
    },
    {
      "id": "assessment-completed"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "rejected",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "rejected",
      "trigger": "reject",
      "condition": "not-eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "basic-form-submitted",
      "trigger": "submit-basic-form"
    },
    {
      "from": "basic-form-submitted",
      "to": "detailed-form-submitted",
      "trigger": "submit-detailed-form"
    },
    {
      "from": "detailed-form-submitted",
      "to": "assessment-scheduled",
      "trigger": "schedule-assessment",
      "condition": "more-information-needed"
    },
    {
      "from": "detailed-form-submitted",
      "to": "decision",
      "trigger": "make-decision",
      "condition": "sufficient-information"
    },
    {
      "from": "assessment-scheduled",
      "to": "assessment-completed",
      "trigger": "complete-assessment"
    },
    {
      "from": "assessment-completed",
      "to": "decision",
      "trigger": "make-decision"
    },
    {
      "from": "decision",
      "to": "completed",
      "trigger": "approve"
    },
    {
      "from": "decision",
      "to": "rejected",
      "trigger": "reject-application"
    }
  ]
}