{
  "id": "nhs.care-assessment.states",
  "version": "1.0.0",
  "states": [
    {
      "id": "not-started",
      "type": "initial"
    },
    {
      "id": "identity-verified"
    },
    {
      "id": "eligibility-checked"
    },
    {
      "id": "consent-given"
    },
    {
      "id": "details-submitted"
    },
    {
      "id": "assessment-scheduled"
    },
    {
      "id": "assessment-in-progress"
    },
    {
      "id": "assessment-completed"
    },
    {
      "id": "decision",
      "receipt": true
    },
    {
      "id": "care-plan-created",
      "receipt": true
    },
    {
      "id": "completed",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "no-care-needs-identified",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "signposted",
      "type": "terminal",
      "receipt": true
    },
    {
      "id": "handed-off",
      "type": "terminal",
      "receipt": true
    }
  ],
  "transitions": [
    {
      "from": "not-started",
      "to": "identity-verified",
      "trigger": "verify-identity"
    },
    {
      "from": "identity-verified",
      "to": "eligibility-checked",
      "trigger": "check-eligibility"
    },
    {
      "from": "eligibility-checked",
      "to": "consent-given",
      "trigger": "grant-consent",
      "condition": "eligible"
    },
    {
      "from": "eligibility-checked",
      "to": "signposted",
      "trigger": "signpost",
      "condition": "not-eligible-but-needs-support"
    },
    {
      "from": "eligibility-checked",
      "to": "handed-off",
      "trigger": "handoff",
      "condition": "edge-case"
    },
    {
      "from": "consent-given",
      "to": "details-submitted",
      "trigger": "submit-details"
    },
    {
      "from": "details-submitted",
      "to": "assessment-scheduled",
      "trigger": "schedule-assessment"
    },
    {
      "from": "assessment-scheduled",
      "to": "assessment-in-progress",
      "trigger": "begin-assessment"
    },
    {
      "from": "assessment-in-progress",
      "to": "assessment-completed",
      "trigger": "complete-assessment"
    },
    {
      "from": "assessment-completed",
      "to": "decision",
      "trigger": "make-decision"
    },
    {
      "from": "decision",
      "to": "care-plan-created",
      "trigger": "create-care-plan",
      "condition": "eligible-for-care"
    },
    {
      "from": "decision",
      "to": "no-care-needs-identified",
      "trigger": "no-needs-found",
      "condition": "no-eligible-needs"
    },
    {
      "from": "care-plan-created",
      "to": "completed",
      "trigger": "finalize-plan"
    }
  ]
}